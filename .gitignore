# Secrets — never commit your API key
.env

# Python virtual environment and caches
.venv/
__pycache__/
*.pyc

# Mac junk
.DS_Store

# Local database file (we rebuild it from Parquet)
*.duckdb
*.duckdb.wal

# Raw API responses: large and re-creatable by running ingest.py.
# We keep them on disk but out of Git (decided in Phase 3; revisit in Phase 8).
data/raw/**/*.json

# Built tables: re-created by running the pipeline
data/staging/*.parquet

# Personal SQL practice files
sql/practice/
data/marts/*.parquet
